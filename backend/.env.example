# Copy this file to .env before deployment. The defaults are suitable for local development.
DATABASE_URL=sqlite:///./veriattend.db
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
RECOGNITION_THRESHOLD=0.6
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_BORDERLINE_THRESHOLD=0.55
LIVENESS_TEXTURE_THRESHOLD=50.0
CAMERA_SAMPLE_INTERVAL_MS=1500
PREVENT_DUPLICATE_ATTENDANCE=true
